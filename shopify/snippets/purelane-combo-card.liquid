{% comment %}
  Snippet: purelane-combo-card.liquid
  Renders an individual combo card styled cleanly like the bundles tier cards
{% endcomment %}

{%- assign b = block.settings -%}
<article class="glass tier combo-card {% if b.is_featured %}best{% endif %} rv" id="combo-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="tier-tags">
    {% if b.savings_text != blank %}
      <span class="tag">{{ b.savings_text }}</span>
    {% endif %}
    {% if b.flag_text != blank %}
      <span class="flag-pill">{{ b.flag_text }}</span>
    {% endif %}
  </div>

  <div class="tierpix" aria-hidden="true">
    {% if block.settings.product_1 != blank and block.settings.product_1.featured_image %}
      <img src="{{ block.settings.product_1.featured_image | image_url: width: 200 }}" alt="{{ block.settings.product_1.title | escape }}" class="pimg" style="height:62px;object-fit:contain;" width="62" height="62">
    {% else %}
      <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
    {% endif %}
    {% if block.settings.product_2 != blank and block.settings.product_2.featured_image %}
      <img src="{{ block.settings.product_2.featured_image | image_url: width: 200 }}" alt="{{ block.settings.product_2.title | escape }}" class="pimg" style="height:62px;object-fit:contain;" width="62" height="62">
    {% else %}
      <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
    {% endif %}
    {% if b.benefit_3 != blank or block.settings.product_3 != blank %}
      {% if block.settings.product_3 != blank and block.settings.product_3.featured_image %}
        <img src="{{ block.settings.product_3.featured_image | image_url: width: 200 }}" alt="{{ block.settings.product_3.title | escape }}" class="pimg" style="height:62px;object-fit:contain;" width="62" height="62">
      {% else %}
        <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
      {% endif %}
    {% endif %}
  </div>

  <h3 class="combo-title">{{ b.title }}</h3>
  <div class="qty" style="margin-top:2px">
    {{ b.product_count | default: "3 Products" }}
  </div>

  <div class="price">
    {{ b.price }}
    {% if b.compare_price != blank %}
      <s>{{ b.compare_price }}</s>
    {% endif %}
  </div>

  <p class="body-s" style="font-size:12px; margin-bottom:14px; color: var(--paper-2); line-height:1.45;">{{ b.description }}</p>

  <ul style="margin: 0 0 20px; display: grid; gap: 8px; list-style: none;">
    {% if b.benefit_1 != blank %}
      <li style="display: flex; gap: 9px; font-size: 12.5px; color: var(--paper-2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width:14px; height:14px; color:var(--accent); flex-shrink:0; margin-top:3px;">
          <path d="m5 13 4 4L19 7"/>
        </svg>
        {{ b.benefit_1 }}
      </li>
    {% endif %}
    {% if b.benefit_2 != blank %}
      <li style="display: flex; gap: 9px; font-size: 12.5px; color: var(--paper-2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width:14px; height:14px; color:var(--accent); flex-shrink:0; margin-top:3px;">
          <path d="m5 13 4 4L19 7"/>
        </svg>
        {{ b.benefit_2 }}
      </li>
    {% endif %}
    {% if b.benefit_3 != blank %}
      <li style="display: flex; gap: 9px; font-size: 12.5px; color: var(--paper-2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width:14px; height:14px; color:var(--accent); flex-shrink:0; margin-top:3px;">
          <path d="m5 13 4 4L19 7"/>
        </svg>
        {{ b.benefit_3 }}
      </li>
    {% endif %}
  </ul>

  {%- if block.settings.product_1 != blank and block.settings.product_1.available -%}
    <form method="post" action="/cart/add" class="purelane-ajax-form" style="margin-top:auto;">
      <input type="hidden" name="items[0][id]" value="{{ block.settings.product_1.selected_or_first_available_variant.id }}">
      <input type="hidden" name="items[0][quantity]" value="1">
      {% if block.settings.product_2 != blank and block.settings.product_2.available %}
        <input type="hidden" name="items[1][id]" value="{{ block.settings.product_2.selected_or_first_available_variant.id }}">
        <input type="hidden" name="items[1][quantity]" value="1">
      {% endif %}
      {% if block.settings.product_3 != blank and block.settings.product_3.available %}
        <input type="hidden" name="items[2][id]" value="{{ block.settings.product_3.selected_or_first_available_variant.id }}">
        <input type="hidden" name="items[2][quantity]" value="1">
      {% endif %}

      <button type="submit" class="btn {% if b.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" style="width:100%; justify-content:center;">
        Shop bundle
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h13m-5-6 6 6-6 6"/>
        </svg>
      </button>
    </form>
  {%- else -%}
    <a href="#bundles" class="btn {% if b.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" style="width:100%; justify-content:center; margin-top:auto;">
      Shop bundle
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
    </a>
  {%- endif -%}
</article>
