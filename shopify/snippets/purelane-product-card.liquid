{% comment %}
  Snippet: purelane-product-card.liquid
  Accepts:
  - product: Shopify product object
  - badge_text: String override for pill badge
  - delay_class: Stagger animation delay class (e.g. 'rv-d1')
{% endcomment %}

{%- assign rating_score = product.metafields.custom.rating_score | default: 4.8 -%}
{%- assign review_count = product.metafields.custom.review_count | default: 120 -%}
{%- assign pill_badge = badge_text | default: product.metafields.custom.badge_text -%}

<div class="product-card glass rv {{ delay_class }}">
  {% if pill_badge != blank %}
    <span class="card-badge">{{ pill_badge }}</span>
  {% endif %}

  <div class="card-media">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="300"
        height="300"
      >
    {% else %}
      <div class="svg-placeholder" aria-label="No image available">
        <svg viewBox="0 0 100 100" width="100" height="100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="100" height="100" rx="16" fill="url(#placeholder-grad)"/>
          <path d="M50 25C40 25 35 35 35 50C35 65 40 75 50 75C60 75 65 65 65 50C65 35 60 25 50 25Z" stroke="#f0a03c" stroke-width="3"/>
          <defs>
            <linearGradient id="placeholder-grad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
              <stop stop-color="#4b3a8f"/>
              <stop offset="1" stop-color="#17102b"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    {% endif %}
  </div>

  <div class="card-content">
    <div class="card-rating">
      <span class="stars">★★★★★</span>
      <span class="rating-text">{{ rating_score }} ({{ review_count }})</span>
    </div>

    <h3 class="card-title line-clamp" title="{{ product.title | escape }}">
      {{ product.title }}
    </h3>

    <div class="card-price">
      <span class="current-price">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="compare-price">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>

    <form method="post" action="/cart/add" class="purelane-ajax-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      
      {% if product.available %}
        <button type="submit" class="btn btn-primary btn-sm full-width">
          Add to Cart
        </button>
      {% else %}
        <button type="button" class="btn btn-ghost btn-sm full-width" disabled>
          Sold out
        </button>
      {% endif %}
    </form>
  </div>
</div>
