{% comment %}
  Section: purelane-bundles.liquid
  Build your bundle tiers matching Purelane prototype exactly
{% endcomment %}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: "Build your bundle" }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.section_heading | default: "One box. Every room." }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.lede | default: "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }}</p>
      </div>
    </div>

    <div class="tiers">
      {% for block in section.blocks %}
        {% assign b = block.settings %}
        <article class="glass tier {% if b.is_featured %}best{% endif %} rv rv-d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="tag">{{ b.tag }}</span>

          <div class="tierpix {% if forloop.index == 3 %}five{% endif %}" aria-hidden="true">
            {% if forloop.index == 1 %}
              <span class="pimg p-combo2" role="img" aria-label="Starter combo pack"></span>
            {% elsif forloop.index == 2 %}
              <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
              <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
              <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
            {% else %}
              <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
              <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
              <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
              <span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span>
              <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
            {% endif %}
          </div>

          <div class="qty">
            {% if forloop.index == 1 %}2{% elsif forloop.index == 2 %}3{% else %}5{% endif %}
            <small>Products</small>
          </div>

          <div class="price">
            {{ block.settings.price }}
            {% if block.settings.compare_price != blank %}
              <s>{{ block.settings.compare_price }}</s>
            {% endif %}
          </div>

          <p class="body-s" style="font-size:12px">{{ b.per_product_note }}</p>

          <ul>
            {% if block.settings.feature_1 != blank %}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                {{ block.settings.feature_1 }}
              </li>
            {% endif %}
            {% if b.feature_2 != blank %}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                {{ b.feature_2 }}
              </li>
            {% endif %}
            {% if b.feature_3 != blank %}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                {{ b.feature_3 }}
              </li>
            {% endif %}
          </ul>

          {%- if b.product_1 != blank and b.product_1.available -%}
            <form method="post" action="/cart/add" class="purelane-ajax-form">
              <input type="hidden" name="items[0][id]" value="{{ b.product_1.selected_or_first_available_variant.id }}">
              <input type="hidden" name="items[0][quantity]" value="1">
              {% if b.product_2 != blank and b.product_2.available %}
                <input type="hidden" name="items[1][id]" value="{{ b.product_2.selected_or_first_available_variant.id }}">
                <input type="hidden" name="items[1][quantity]" value="1">
              {% endif %}
              {% if b.product_3 != blank and b.product_3.available %}
                <input type="hidden" name="items[2][id]" value="{{ b.product_3.selected_or_first_available_variant.id }}">
                <input type="hidden" name="items[2][quantity]" value="1">
              {% endif %}

              <button type="submit" class="btn {% if b.is_featured %}btn-primary{% else %}btn-ghost{% endif %}">
                {{ b.cta_text | default: "Build this box" }}
                {% if b.is_featured %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                {% endif %}
              </button>
            </form>
          {%- else -%}
            <a href="#shop" class="btn {% if b.is_featured %}btn-primary{% else %}btn-ghost{% endif %}">
              {{ b.cta_text | default: "Build this box" }}
              {% if b.is_featured %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              {% endif %}
            </a>
          {%- endif -%}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
