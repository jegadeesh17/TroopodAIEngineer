          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": "COD available"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "bundle_tier",
          "settings": {
            "tag": "Starter",
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India",
            "feature_3": "COD available",
            "cta_text": "Build this box"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "is_featured": true,
            "tag": "Most popular",
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India",
            "cta_text": "Build this box"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "tag": "Whole home",
            "price": "₹799",
            "compare_price": "₹1,495",
            "per_product_note": "Flat ₹160 per product",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India",
            "cta_text": "Build this box"
          }
        }
      ]
    }
  ]
}
{% endschema %}
