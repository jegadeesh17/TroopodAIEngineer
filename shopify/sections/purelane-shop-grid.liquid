{% comment %}
  Section: purelane-shop-grid.liquid
  Dynamic product grid matching Purelane prototype exactly
{% endcomment %}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: "Bestsellers" }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.section_heading | default: "Loved by 30,000 homes" }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign selected_collection = section.settings.collection | default: collections.all -%}
      {%- assign count_limit = section.settings.products_to_show | default: 8 -%}

      {%- if selected_collection != blank and selected_collection.products.size > 0 -%}
        {%- for product in selected_collection.products limit: count_limit -%}
          {%- assign d_idx = forloop.index | modulo: 4 -%}
          {%- render 'purelane-product-card', product: product, delay_index: d_idx -%}
        {%- endfor -%}
      {%- elsif collections.all.products.size > 0 -%}
        {%- for product in collections.all.products limit: count_limit -%}
          {%- assign d_idx = forloop.index | modulo: 4 -%}
          {%- render 'purelane-product-card', product: product, delay_index: d_idx -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
