{% comment %}
  Section: purelane-hero.liquid
  Purelane Hero Section with 3-step interactive bottle stage, botanical badge rail, and responsive typography.
{% endcomment %}

<section class="hero" id="hero-{{ section.id }}" data-scene="1">
  <div class="hero-grid">

    <!-- HERO COPY (LEFT COLUMN) -->
    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.headline | default: "Clean" }}<br>
        That<br>
        <span class="lime">{{ section.settings.headline_accent | default: "Lasts" }}</span>
      </h1>

      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      <p class="lede rv rv-d2">
        {{ section.settings.subtext | default: "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." }}
      </p>

      <div class="hero-cta rv rv-d3">
        {% if section.settings.cta_primary_text != blank %}
          <a class="btn btn-primary" href="{{ section.settings.cta_primary_url | default: '#shop' }}">
            {{ section.settings.cta_primary_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.cta_secondary_text != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.cta_secondary_url | default: '#combos' }}">
            {{ section.settings.cta_secondary_text }}
          </a>
        {% endif %}
      </div>

      <!-- MOBILE BADGE STRIP -->
      <div class="badgestrip rv rv-d4">
        {% if section.settings.badge_1_text != blank %}
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>
            {{ section.settings.badge_1_text }}
          </div>
        {% endif %}
        {% if section.settings.badge_2_text != blank %}
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
              <path d="m9 12 2.2 2.2L15.4 10"/>
            </svg>
            {{ section.settings.badge_2_text }}
          </div>
        {% endif %}
        {% if section.settings.badge_3_text != blank %}
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="8.4"/>
              <path d="M6.4 17.6 17.6 6.4"/>
            </svg>
            {{ section.settings.badge_3_text }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- HERO SHOWCASE (RIGHT COLUMN) -->
    <div class="hero-showcase" id="heroProd-{{ section.id }}">
      <div class="hero-glow" aria-hidden="true"></div>

      <!-- PRODUCT STAGE -->
      <div class="hero-prod-stage">
        <div class="hstage" id="hstage-{{ section.id }}">
          {% for block in section.blocks %}
            {% assign sidx = forloop.index %}
            <div class="hslide hs{{ sidx }} {% if forloop.first %}on{% endif %}" data-n="{{ sidx }}" {{ block.shopify_attributes }}>
              {% if sidx == 1 %}
                <span class="hp p-kbtl a d1" role="img" aria-label="{{ block.settings.label | escape }}"></span>
              {% elsif sidx == 2 %}
                <span class="hp p-tbtl a d1" role="img" aria-label="Tap cleaner"></span>
                <span class="hp p-kbtl b d2" role="img" aria-label="Kitchen cleaner"></span>
              {% else %}
                <span class="hp p-tbtl a d1" role="img" aria-label="Tap cleaner"></span>
                <span class="hp p-mbtl b d2" role="img" aria-label="Copper & brass cleaner"></span>
                <span class="hp p-kbtl c d3" role="img" aria-label="Kitchen cleaner"></span>
              {% endif %}

              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label }}</span>
                <div class="val">
                  <strong>{{ block.settings.price }}</strong>
                  {% if block.settings.compare_price != blank %}
                    <s>{{ block.settings.compare_price }}</s>
                  {% endif %}
                </div>
                {% if block.settings.savings_tag != blank %}
                  <span class="cut">{{ block.settings.savings_tag }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="hdots" id="hdots-{{ section.id }}">
          {% for block in section.blocks %}
            <button type="button" class="{% if forloop.first %}on{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      </div>

      <!-- DESKTOP PROMISE BADGES -->
      <div class="badges glass-2" aria-label="Product promises">
        {% if section.settings.badge_1_text != blank %}
          <div class="badge">
            <span class="bi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              </svg>
            </span>
            <span>{{ section.settings.badge_1_text }}</span>
          </div>
        {% endif %}
        {% if section.settings.badge_2_text != blank %}
          <div class="badge">
            <span class="bi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                <path d="m9 12 2.2 2.2L15.4 10"/>
              </svg>
            </span>
            <span>{{ section.settings.badge_2_text }}</span>
          </div>
        {% endif %}
        {% if section.settings.badge_3_text != blank %}
          <div class="badge">
            <span class="bi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="8.4"/>
                <path d="M6.4 17.6 17.6 6.4"/>
              </svg>
            </span>
            <span>{{ section.settings.badge_3_text }}</span>
          </div>
        {% endif %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline First Line",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline Accent Word",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary Button Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary Button Text",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Safe for kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh chemicals"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Stage Slide",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Display Price",
          "default": "₹249"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "savings_tag",
          "label": "Savings Tag",
          "default": "Save ₹100"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "hero_slide",
          "settings": {
            "label": "Single bottle",
            "price": "₹249",
            "compare_price": "₹349",
            "savings_tag": "Save ₹100"
          }
        },
        {
          "type": "hero_slide",
          "settings": {
            "label": "Duo pack",
            "price": "₹449",
            "compare_price": "₹698",
            "savings_tag": "Save ₹249"
          }
        },
        {
          "type": "hero_slide",
          "settings": {
            "label": "Trio bundle",
            "price": "₹599",
            "compare_price": "₹997",
            "savings_tag": "Save ₹398"
          }
        }
      ]
    }
  ]
}
{% endschema %}
