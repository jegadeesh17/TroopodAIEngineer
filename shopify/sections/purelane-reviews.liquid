{% comment %}
  Section: purelane-reviews.liquid
  Customer Reviews Marquee matching Purelane prototype exactly
{% endcomment %}

<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <b>{{ section.settings.aggregate_rating | default: "4.8" }}</b>
        {{ section.settings.review_count_text | default: "from 8,000+ reviews" }}
      </span>
      {% if section.settings.social_proof_text != blank %}
        <span class="agg">{{ section.settings.social_proof_text }}</span>
      {% endif %}
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack" style="animation-duration: {{ section.settings.marquee_speed | default: 35 }}s;">
      {%- capture cards_markup -%}
        {% for block in section.blocks %}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">
              {% assign star_num = block.settings.stars | default: 5 %}
              {% for i in (1..star_num) %}&#9733;{% endfor %}
            </div>
            {% if block.settings.heading != blank %}
              <h5>{{ block.settings.heading }}</h5>
            {% endif %}
            <p>{{ block.settings.body }}</p>
            <div class="who">
              {% if block.settings.verified %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              {% endif %}
              <b>{{ block.settings.reviewer_name }}</b>
              {% if block.settings.product_tag != blank %}
                <span>{{ block.settings.product_tag }}</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {%- endcapture -%}
      {{ cards_markup }}
      {{ cards_markup }}
    </div>
    <div class="revtrack" aria-hidden="true" style="animation-duration: {{ section.settings.marquee_speed | default: 35 }}s;">
      {{ cards_markup }}
      {{ cards_markup }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review Count Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Social Proof Text",
      "default": "Loved by 12 lakh+ homes"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "label": "Marquee Speed"
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review Card",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline",
          "default": "The tap cleaner melted hard water marks"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Body",
          "default": "We have very hard borewell water in Bangalore. Standard cleaners did nothing. This took two sprays and one wipe."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Ananya R."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer",
          "default": true
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag",
          "default": "Tap & Limescale"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review_card",
          "settings": {
            "heading": "The tap cleaner melted hard water marks",
            "body": "We have very hard borewell water in Bangalore. Standard cleaners did nothing. This took two sprays and one wipe.",
            "reviewer_name": "Ananya R.",
            "product_tag": "Tap & Limescale"
          }
        },
        {
          "type": "review_card",
          "settings": {
            "heading": "No cough when spraying the kitchen hob",
            "body": "Usually kitchen sprays make me sneeze and cough. Purelane smells like mild citrus and cuts grease just as fast.",
            "reviewer_name": "Vikram M.",
            "product_tag": "Kitchen Cleaner"
          }
        },
        {
          "type": "review_card",
          "settings": {
            "heading": "Copper pooja vessels shine like new",
            "body": "Tried pitambari for years, hated the smell. This brass cleaner is gentle on hands and works in seconds.",
            "reviewer_name": "Gayatri S.",
            "product_tag": "Copper & Brass"
          }
        },
        {
          "type": "review_card",
          "settings": {
            "heading": "My washing machine stopped smelling",
            "body": "One tablet on tub clean mode removed months of detergent buildup and musty smell. Essential buy.",
            "reviewer_name": "Rohit K.",
            "product_tag": "Descaler"
          }
        }
      ]
    }
  ]
}
{% endschema %}
